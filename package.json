    "@sanity/vision": "^5.31.2",
    "jose": "^6.2.3",
    "next": "15.5.27",
    "next-sanity": "^13.3.4",
    "react": "19.2.2",
    "react-dom": "19.2.2",
    "resend": "^4.0.0",
    "sanity": "^5.31.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.4",
